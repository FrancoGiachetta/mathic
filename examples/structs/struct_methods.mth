struct Point {
    x: u32,
    y: u32
}

expand Point {
    df new(x: u32, y: u32) Point {
        return Point {
            x: x,
            y: y
        };
    }

    df add(self, rhs: Point) Point {
        return Point {
            x: self.x + rhs.x,
            y: self.y + rhs.y
        };
    }
}

df main() {
    let point_1: Point = Point {
        x: 5,
        y: 5
    };

    let point_2: Point = Point {
        x: 10,
        y: 10
    };

    return point_1.add(point_2);
}
